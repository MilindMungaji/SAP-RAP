@Metadata.layer: #CORE
@UI.headerInfo: {
    typeName: 'Student',
    typeNamePlural: 'Students',
    title: {
        type: #STANDARD,
        value: 'Rollno'
        },
    description : { value: 'FullName' }
    }
annotate entity zc_iws_student1 with
{
  @UI.facet: [{
      qualifier: '',
      feature: '',
      id: 'facetstudent',
      purpose: #STANDARD,
      parentId: '',
      position: 10,
      importance: #HIGH ,
      label: 'Student Info',
      type: #IDENTIFICATION_REFERENCE,
      targetElement: '',
      targetQualifier: ''

  },
   {
      qualifier: '',
      feature: '',
      id: 'facetfees',
      purpose: #STANDARD,
      parentId: '',
      position: 20,
      label: 'Student Fees Info',
      type: #IDENTIFICATION_REFERENCE,
      targetElement: '_Fees',
      targetQualifier: ''

  },
   {
      qualifier: '',
      feature: '',
      id: 'facetacademy',
      purpose: #STANDARD,
      parentId: '',
      position: 30,
      label: 'Student Academy Info',
      type: #LINEITEM_REFERENCE,
      targetElement: '_Acad',
      targetQualifier: ''

  }]
  @UI.lineItem: [{ position: 10 }]
  @UI.selectionField: [{ position: 10 }]
  @UI.identification: [{ position: 10 }]
  Rollno;
  @UI.lineItem: [{ position: 20 }]
  @UI.selectionField: [{ position: 20 }]
  @UI.identification: [{ position: 20 }]
  Dept;
  @UI.lineItem: [{ position: 30 }]
  @UI.selectionField: [{ position: 30 }]
